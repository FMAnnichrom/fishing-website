# Server configuration
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# Database configuration (SQLite local default; optional MongoDB URI for external deployments)
SQLITE_DB_PATH="./data/phishing_detector.db"
MONGODB_URI=""

# Admin endpoint protection (required for /api/admin/* endpoints)
ADMIN_API_KEY="CHANGE_ME_TO_A_STRONG_RANDOM_SECRET"

# Python FastAPI ML service URL (optional; falls back to embedded trained ML inference engine if unset/unreachable)
ML_SERVICE_URL=""
ML_SERVICE_TIMEOUT_MS=4000

# Threat Intelligence API Keys (server-side only, never exposed to client)
# Google Safe Browsing API v4: https://developers.google.com/safe-browsing/v4/get-started
GOOGLE_SAFE_BROWSING_API_KEY=""
# PhishTank API: https://phishtank.org/api_info.php
PHISHTANK_API_KEY=""
PHISHTANK_USER_AGENT="phishtank/phishing-url-detector"
# abuse.ch URLhaus Auth Key: https://auth.abuse.ch/
URLHAUS_AUTH_KEY=""

# Public threat feed ingestion (OpenPhish community feed & URLhaus public text/csv feed)
ENABLE_PUBLIC_FEED_SYNC=false
FEED_SYNC_INTERVAL_MINUTES=60

# Optional isolated website inspection (DISABLED BY DEFAULT for security)
ENABLE_WEBSITE_INSPECTION=false
INSPECTION_TIMEOUT_MS=4000
INSPECTION_MAX_BYTES=524288
